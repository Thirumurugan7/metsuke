# Local development only. Copy to .env, which .gitignore excludes.
#
# This file does nothing for a deployment: Vercel reads its own environment variables
# from each project's settings, and the release workflow reads a repository secret. See
# docs/deploy.md for which value belongs where.
#
# You only need this at all to run the telemetry server on your machine
# (`npm start` in server/) or its tests (`npm test` in server/).

# ── Required ─────────────────────────────────────────────────────────────────

# Neon Postgres. Quoted because the URL contains & and an unquoted value breaks any
# naive `source .env`. Use the -pooler host: it is PgBouncer, and it is what makes a
# serverless function opening a connection per request survivable.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Password for the telemetry dashboard: any username, this as the password. The server
# refuses to start without it, because the alternative is your users' data open to
# anyone who finds the URL. Generate one with: openssl rand -hex 32
DASHBOARD_TOKEN="a-long-random-string"

# ── Optional, with sensible defaults ─────────────────────────────────────────

# Which origin may read and write roadmap ticks, assignments and tasks. Defaults to *,
# which is fine locally and worth pinning to your site's URL in the deployment.
# SITE_ORIGIN="https://your-site.vercel.app"

# Events older than this are deleted daily. Install rows survive it.
# RETENTION_DAYS="180"

# Per address, per minute. Raise it if a proxy hides the real one, or every install
# behind it shares a bucket.
# RATE_LIMIT_PER_MINUTE="60"

# Port for the standalone server. Ignored by the Vercel functions.
# PORT="8787"

# ── Do not set ───────────────────────────────────────────────────────────────

# DB_SCHEMA exists for the tests, which create a throwaway schema and drop it. Setting
# it anywhere else points the app at a schema that is not the real one.
