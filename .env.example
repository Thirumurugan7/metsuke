# Copy to .env and fill in. Never commit the filled-in version: .gitignore excludes it.

# Neon Postgres. Use the -pooler host: it is PgBouncer, which is what makes a serverless
# function opening a connection per request survivable.
# Quoted: the URL contains & and an unquoted value breaks any naive `source .env`.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Password for the telemetry dashboard. Any username, this as the password.
DASHBOARD_TOKEN="generate-with-openssl-rand-hex-32"
