{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo 'functions are compiled by Vercel; nothing to build'",
  "outputDirectory": "public",
  "framework": null,
  "functions": {
    "api/*.ts": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/v1/events",
      "destination": "/api/events"
    },
    {
      "source": "/download",
      "destination": "/api/download?path="
    },
    {
      "source": "/download/(.*)",
      "destination": "/api/download?path=$1"
    }
  ]
}
